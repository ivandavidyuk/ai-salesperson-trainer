# Подключение к PostgreSQL (используется Prisma)
DATABASE_URL=

# Подключение к Redis (хранение активных JWT-токенов)
REDIS_URL=

# Секрет для подписи JWT (должен совпадать с FastAPI-сервисом)
JWT_SECRET=

# Срок жизни JWT-токена
JWT_EXPIRES_IN=24h

# Базовый адрес WebSocket-сервера (FastAPI).
# Локально именно 127.0.0.1, а не localhost: Node резолвит localhost в ::1,
# uvicorn по умолчанию слушает только IPv4 — и запрос из роутов Next
# упирается в ECONNREFUSED. Браузеру это безразлично, поэтому промах видно
# только на серверных вызовах вроде генерации случаев.
FASTAPI_WS_URL=ws://127.0.0.1:8000
