// Prisma-схема для голосового ИИ-тренажёра по продажам.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Статус сессии тренировки
enum SessionStatus {
  active
  paused
  completed
}

// Роль автора сообщения в диалоге
enum MessageRole {
  user
  assistant
}

// Вид ежедневного контента на главной
enum DailyContentKind {
  tip
  motivation
}

// Чем закончился разговор. paid — пациент согласился оплатить услугу;
// refused — отказался; not_asked — менеджер так и не предложил оплатить.
// Последние два различаются намеренно: это разные ошибки с разным лечением.
enum DealOutcome {
  paid
  refused
  not_asked
}

// Насколько тяжело продать этому пациенту — плашка в списке выбора
enum PatientDifficulty {
  easy
  mid
  hard
}

// Раздел мастера, в который попадает тип тренировки
enum TrainingGroup {
  full
  stage
  special
}

// Роль пользователя. head — руководитель отдела продаж (РОП):
// назначает задания и видит статистику команды.
enum UserRole {
  manager
  head
}

// Состояние задания от руководителя
enum AssignmentStatus {
  active
  done
}

// Оформление бейджа достижения: навык, «золотое» достижение
// или шуточное за курьёз в разговоре
enum AchievementTone {
  skill
  gold
  fun
}

// Пользователь системы: менеджер по продажам или его руководитель
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(manager)
  // Заполняются в профиле. Клиника пока свободный текст — переедет
  // в связь, когда появятся организации.
  jobTitle     String?
  clinic       String?
  // Клиника, к которой относится пользователь. Необязательное, потому что
  // миграция накатывается на живую базу; заполняется бэкфиллом и скриптом
  // создания пользователя. Сам менеджер организацию не выбирает — иначе
  // попал бы в чужую статистику отдела
  organizationId String?
  // Фото профиля: JPEG после сжатия на клиенте, лежит прямо в базе.
  // Файловая система контейнера не переживает деплой, а том ради
  // сорока килобайт на пользователя заводить незачем.
  avatar       Bytes?
  avatarMime   String?
  // И признак «фото есть», и версия для сброса кеша в URL картинки
  avatarUpdatedAt DateTime?
  createdAt    DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  // Связь: один пользователь — много сессий
  sessions     Session[]

  // Задания: полученные менеджером и выданные руководителем
  assignments        Assignment[] @relation("AssignmentTarget")
  createdAssignments Assignment[] @relation("AssignmentAuthor")

  achievements       UserAchievement[]
}

// Игровой бейдж за прогресс в тренировках. Сам список — общий для всех,
// у кого он получен, хранится в UserAchievement.
model Achievement {
  // Слаг («first-contact», «closer») — стабильный идентификатор
  id          String          @id
  name        String
  description String
  // Ключ иконки: сами SVG живут на фронте
  icon        String
  tone        AchievementTone
  // Порядок в сетке на странице
  position    Int
  createdAt   DateTime        @default(now())

  users       UserAchievement[]
}

// Полученное достижение. Механизма выдачи пока нет — связи проставляет сид.
model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  // Составной ключ: одно достижение выдаётся пользователю ровно один раз
  @@id([userId, achievementId])
}

// Задание от руководителя: предустановленная тренировка с комментарием.
// Менеджер видит их в разделе «Задания» и запускает кнопкой «Начать».
model Assignment {
  id             String           @id @default(uuid())
  // Кому назначено и кто назначил
  userId         String
  createdById    String
  // Что тренировать
  patientId      String
  trainingTypeId String
  // «Возражение по цене операции» — заголовок карточки
  title          String
  // Комментарий руководителя: зачем это задание
  comment        String
  // Срок и признак срочности — из них складывается плашка «Приоритет»
  dueAt          DateTime?
  isPriority     Boolean          @default(false)
  status         AssignmentStatus @default(active)
  createdAt      DateTime         @default(now())
  // Разговор, которым задание закрыли
  completedAt    DateTime?

  user         User         @relation("AssignmentTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("AssignmentAuthor", fields: [createdById], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  trainingType TrainingType @relation(fields: [trainingTypeId], references: [id])

  sessions     Session[]

  // Страница заданий выбирает активные задания пользователя
  @@index([userId, status])
}

// Пациент — персонаж, которого играет ИИ в разговоре.
// Пока используется для подписи разговоров («Тамара Михайловна · катаракта»),
// дальше — на странице «Пациенты» и при выборе сценария тренировки.
model Patient {
  id          String    @id @default(uuid())
  name        String
  // Короткая строка под именем на экране звонка: «62 года · диагностика зрения»
  description String?
  // Анамнез: что менеджеру полезно знать о пациенте до разговора.
  // Показывается отдельным блоком на экране звонка перед стартом.
  anamnesis   String?
  // Роль для LLM: кого играет ИИ в разговоре. Backend собирает системный
  // промпт из этого текста и промпта выбранного типа тренировки.
  prompt      String?
  // Разбор пациента для руководителя. Менеджеру эти поля не отдаются:
  // подсказка «как выиграть клиента» обесценила бы тренировку.
  character     String?
  objections    String[]
  decisionMaker String?
  approach      String?
  // Сложность пациента в мастере настройки тренировки
  difficulty  PatientDifficulty @default(mid)
  // Пациенты, для которых ещё нет промпта, лежат неактивными: в мастере они
  // видны, но выбрать их нельзя
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  sessions    Session[]
  assignments Assignment[]
  // Случаи под разные клиники: личность одна, а с чем человек пришёл —
  // зависит от отрасли
  cases       PatientCase[]
}

// Тип тренировки: полный разговор, отдельный этап сделки или спецнавык.
// Для LLM это добавка к промпту пациента — «ты сейчас на этапе …».
model TrainingType {
  // Слаг («full», «s1», «intercept») — стабильный идентификатор,
  // на него ссылаются сессии и мастер настройки
  id          String        @id
  title       String
  description String
  group       TrainingGroup
  // Инструкция этапа для LLM
  prompt      String
  // Порядок внутри группы в мастере
  position    Int
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  sessions    Session[]
  assignments Assignment[]
}

// Сессия (один тренировочный разговор)
model Session {
  id          String        @id @default(uuid())
  userId      String
  patientId   String?
  status      SessionStatus @default(active)
  // Тема разговора: «катаракта», «очки для чтения»
  topic       String?
  // Что тренировали: полный разговор или отдельный этап
  trainingTypeId String?
  // Задание, по которому запущен разговор (если запускали из «Заданий»)
  assignmentId   String?
  // Длительность в секундах, проставляется при завершении.
  // Хранится отдельно, чтобы считать среднюю длину одним запросом.
  durationSec Int?
  isFavorite  Boolean       @default(false)
  startedAt   DateTime      @default(now())
  endedAt     DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id])
  trainingType TrainingType? @relation(fields: [trainingTypeId], references: [id])
  assignment   Assignment?   @relation(fields: [assignmentId], references: [id])

  messages    Message[]
  review      SessionReview?

  // Главная постоянно выбирает разговоры пользователя по дате
  @@index([userId, startedAt])
}

// Сообщение внутри сессии (реплика менеджера или клиента-ИИ)
model Message {
  id        String      @id @default(uuid())
  sessionId String
  role      MessageRole
  text      String
  createdAt DateTime    @default(now())

  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Разбор одного разговора: оценки по этапам сделки и текстовые выводы.
// Связь 1:1 с сессией и необязательная — разбор появляется после разговора,
// а у старых сессий его может не быть вовсе.
model SessionReview {
  id              String   @id @default(uuid())
  sessionId       String   @unique

  // Общая оценка разговора, 0–10
  overallScore    Float
  // Оценки по этапам сделки, 0–10 — из них считается недельный «Прогресс»
  contactScore    Float
  iceBreakerScore Float
  needsScore      Float
  objectionsScore Float
  // Пятый этап. Nullable: у разговоров, разобранных до появления механизма
  // определения исхода, закрытие не оценивалось — ноль был бы неправдой
  closingScore    Float?

  // Чем закончился разговор. Nullable по той же причине
  outcome         DealOutcome?

  // Текстовые выводы разбора
  strength        String
  growthPoint     String

  // Разбор оценщика по обязательным условиям: какие сняты, какие нет.
  // Менеджеру не отдаётся — иначе получит готовый чек-лист на следующую
  // попытку. Нужен нам для проверки объективности и РОПу
  judgeNotes      String?

  createdAt       DateTime @default(now())

  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Клиника, к которой привязаны и руководитель, и его менеджеры.
//
// До этой модели система была однопользовательской по факту: статистика
// отдела считалась по всем менеджерам базы, а специализация клиники нигде
// не хранилась — пациенты были жёстко офтальмологическими.
//
// Отрасль и услуги заполняет руководитель свободным текстом: перечислить
// заранее все специализации и все услуги невозможно, поэтому ответственность
// за качество данных — на нём. По ним генерируется слой «случай» у пациентов.
model Organization {
  id       String    @id @default(uuid())
  name     String
  // Свободный текст: «офтальмология», «стоматология: терапия и имплантация»
  industry String
  services Service[]
  users    User[]
  cases    PatientCase[]

  // Прогресс сборки случаев: форму сохранили — пациенты пересобираются.
  // Руководитель ждёт с лоадером, поэтому ему нужно видеть, сколько готово
  casesTotal     Int       @default(0)
  casesReady     Int       @default(0)
  casesUpdatedAt DateTime?
  // Идёт ли сборка прямо сейчас. Без этого флага страница не отличает
  // «ещё собираем» от «кончилось, часть не собралась»: счётчик в обоих
  // случаях замирает, и лоадер крутится вечно. Читать его в одиночку нельзя —
  // рестарт контейнера посреди сборки оставит флаг поднятым навсегда,
  // поэтому живость определяется вместе с casesUpdatedAt
  casesRunning   Boolean   @default(false)
  // Когда последний раз сохраняли форму. По нему «Собрать заново» продолжает
  // с места обрыва, а не идёт по кругу: случай, собранный позже этой отметки,
  // уже отвечает текущим данным клиники и пересобирать его незачем.
  // На сотне пациентов разница — вдвое меньше вызовов модели после обрыва
  formSavedAt    DateTime?

  createdAt DateTime @default(now())
}

// Услуга клиники: то, что менеджер продаёт, а пациент боится оплатить.
model Service {
  id             String @id @default(uuid())
  organizationId String
  name           String
  // Строкой, а не числом: «60 000 ₽ за глаз», «от 18 000», «по договорённости» —
  // всё это настоящие ответы, и приведение к числу потеряло бы смысл
  price          String
  description    String?
  // Порядок в форме: руководитель расставляет услуги как ему удобно
  position       Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, position])
}

// Слой «случай» пациента, собранный под конкретную клинику.
//
// Личность пациента живёт в Patient и одна на всех: она написана вручную
// и при смене отрасли не меняется. Случай — то, с чем этот человек пришёл
// в эту клинику, — генерируется по её отрасли и услугам.
//
// Пока записи нет, backend читает Patient.prompt как раньше. Это и страховка
// на выкатку, и рабочий режим для клиник, не заполнивших форму.
model PatientCase {
  patientId      String
  organizationId String

  // Готовая строка для backend: личность + случай + слой механизма.
  // Собирается тем же buildRolePrompt, что и промпты в сиде, — второй
  // реализации сборщика не существует, значит нечему разъезжаться
  prompt String
  // Слоты случая отдельно — под редактор пациентов: правка одного поля
  // не должна требовать перегенерации всего
  caseData Json

  // Видимые поля, которые тоже принадлежат отрасли. approach сюда не входит:
  // его пишет автор пациента, и пишет без привязки к медицинской проблеме
  description String
  anamnesis   String
  objections  String[]

  generatedAt DateTime @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([patientId, organizationId])
}

// «Совет дня» и «Мотивация» на главной.
// Меняются раз в сутки: элемент выбирается по индексу дня
// (день % количество), поэтому не нужен ни крон, ни поле с датой.
model DailyContent {
  id        String           @id @default(uuid())
  kind      DailyContentKind
  text      String
  // Порядок ротации внутри своего вида.
  // Уникальность пары защищает от дублей при массовой заливке списка
  // и делает возможным upsert по (kind, position).
  position  Int
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@unique([kind, position])
}
