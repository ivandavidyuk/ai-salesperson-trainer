# Сборка Next.js для продакшена (одна стадия — без COPY node_modules между слоями).
# node:20-bookworm: openssl уже есть, apt на VPS часто недоступен.

FROM node:20-bookworm
WORKDIR /app

ENV NPM_CONFIG_FETCH_TIMEOUT=600000 \
    NPM_CONFIG_FETCH_RETRIES=5

COPY package.json package-lock.json ./

# npm ci на медленных VPS иногда ставит пакеты неполно — prisma доустанавливаем явно
RUN npm ci --include=dev \
    && npm install prisma@5.18.0 --no-save \
    && test -x node_modules/.bin/prisma

COPY . .

RUN node_modules/.bin/prisma generate \
    && npm run build

ENV NODE_ENV=production
EXPOSE 3000
# Пересборка промптов и заливка ежедневного контента между миграциями
# и стартом: наши правки механизма, личностей и подборки советов доезжают
# до клиентов сами, без кнопки и без обращений к модели.
#
# Иначе это тихий провал: PR с новыми цитатами смержится, деплой позеленеет,
# а на главной ничего не изменится — заметить можно только зайдя и посмотрев.
#
# Обратная сторона: репозиторий становится единственным источником правды.
# Правка текстов прямо в базе переживёт работу сервиса, но не следующий
# рестарт. Интерфейса для таких правок нет, так что терять нечего.
#
# Скобки не случайны. Миграция — жёсткий заслон: не прошла, приложение
# подниматься не должно. Остальные два шага мягкие: они освежают данные,
# и их сбой оставит прежние тексты, что несравнимо лучше лежащего сервиса.
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && { npm run rebuild:prompts || echo 'ПЕРЕСБОРКА ПРОМПТОВ НЕ УДАЛАСЬ — промпты остались прежними'; } && { npm run seed:content || echo 'ЗАЛИВКА СОВЕТОВ НЕ УДАЛАСЬ — тексты остались прежними'; } && npm run start"]
