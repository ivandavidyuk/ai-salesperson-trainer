# Caddy: реверс-прокси с автоматическим HTTPS (Let's Encrypt).
# Домен, email и адрес голосового backend берутся из переменных окружения
# (см. docker-compose.prod.yml и корневой .env).

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# WebSocket голосовой сессии → FastAPI на зарубежном VPS.
	# Путь сохраняется как есть (/ws/session/{id}), апгрейд соединения
	# Caddy проксирует автоматически.
	@ws path /ws/*
	reverse_proxy @ws {$BACKEND_UPSTREAM}

	# Сборка случаев пациентов → туда же, на FastAPI.
	#
	# Роуты Next зовут этот путь по адресу из FASTAPI_WS_URL, а это наш
	# собственный домен: без правила запрос возвращался в Next.js, тот
	# не знал такого роута и редиректил на /login. Сборка падала на всех
	# двадцати одном пациенте, а backend не видел ни одного запроса
	@cases path /cases/*
	reverse_proxy @cases {$BACKEND_UPSTREAM}

	# Генерация результата диагностики → FastAPI, по той же причине,
	# что и /cases/*: sessions/start зовёт её по FASTAPI_WS_URL, то есть
	# по нашему же домену. Без правила запрос вернулся бы в Next.js
	@diagnostics path /diagnostics/*
	reverse_proxy @diagnostics {$BACKEND_UPSTREAM}

	# Всё остальное (интерфейс + REST API) → Next.js
	reverse_proxy frontend:3000
}
